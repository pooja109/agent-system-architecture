# Test Environment Configuration
# =============================
# 
# Copy this file to .env and customize for your environment.
# These environment variables override default test configuration.

# =============================================================================
# Service Configuration
# =============================================================================

# Inbox Monitor Service
INBOX_MONITOR_HOST=localhost
INBOX_MONITOR_PORT=8080

# Email Agent Service  
EMAIL_AGENT_HOST=localhost
EMAIL_AGENT_PORT=8081

# =============================================================================
# Kubernetes Configuration
# =============================================================================

# Kubernetes namespace for tests
K8S_NAMESPACE=email-agents-test

# Kubernetes context (optional, uses default if not set)
K8S_CONTEXT=

# Path to kubeconfig file (optional, uses default if not set)
KUBECONFIG=

# =============================================================================
# Monitoring Configuration  
# =============================================================================

# Prometheus
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_HOST=localhost
GRAFANA_PORT=3000

# AlertManager
ALERTMANAGER_HOST=localhost
ALERTMANAGER_PORT=9093

# =============================================================================
# Performance Testing Configuration
# =============================================================================

# Test duration in seconds
PERF_DURATION=60

# Number of concurrent users
PERF_CONCURRENT_USERS=10

# Performance thresholds
REQUIRED_RPS=10
MAX_RESPONSE_TIME_MS=2000
MAX_ERROR_RATE_PERCENT=5
MIN_SUCCESS_RATE_PERCENT=95

# =============================================================================
# Container Configuration
# =============================================================================

# Container registry
CONTAINER_REGISTRY=docker.io

# Container namespace/organization
CONTAINER_NAMESPACE=email-agents

# Container image tag
CONTAINER_TAG=latest

# =============================================================================
# Security Configuration
# =============================================================================

# Security scanning namespace
SECURITY_NAMESPACE=email-agents

# Install security tools automatically
INSTALL_SECURITY_TOOLS=false

# =============================================================================
# Test Environment
# =============================================================================

# Test environment (test, staging, production)
TEST_ENVIRONMENT=test

# Verbose logging
VERBOSE=false

# Test mode flags
RUN_INTEGRATION_TESTS=true
RUN_PERFORMANCE_TESTS=true
RUN_SECURITY_TESTS=true

# =============================================================================
# Tool Configuration
# =============================================================================

# Install testing tools automatically
INSTALL_TOOLS=false

# Kubernetes mode
K8S_MODE=false

# Local testing mode
LOCAL_MODE=true