# Email Agent Service Configuration - EXAMPLE
# ============================================
# This file contains example values for reference
# Copy to .env and replace with your actual values

# Service Identification
SERVICE_NAME=email-agent
ENVIRONMENT=development

# Azure Key Vault Configuration
# WARNING: NEVER commit real credentials! These are example values only.
AZURE_KEY_VAULT_URL=https://YOUR-KEYVAULT-NAME-HERE.vault.azure.net/
AZURE_TENANT_ID=YOUR-TENANT-ID-HERE-1234-1234-123456789012
AZURE_CLIENT_ID=YOUR-CLIENT-ID-HERE-4321-4321-210987654321
AZURE_CLIENT_SECRET=YOUR-CLIENT-SECRET-HERE-NEVER-COMMIT-REAL-VALUES

# Key Vault Secret Names (Service Principal)
KEY_VAULT_TENANT_ID_SECRET=sales-engagement-service-principal-tenantid
KEY_VAULT_CLIENT_ID_SECRET=sales-engagement-service-principal-clientid
KEY_VAULT_CLIENT_SECRET_SECRET=sales-engagement-service-principal-secretid

# Key Vault Secret Names (Azure Communication Services)
KEY_VAULT_ACS_CONNECTION_STRING_SECRET=azure-communication-connection-string
KEY_VAULT_ACS_SENDER_EMAIL_SECRET=azure-communication-sender-email

# Azure Storage Configuration (Use either connection string OR account name + SAS token)
# WARNING: Replace with your actual storage credentials
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR-STORAGE-ACCOUNT;AccountKey=YOUR-STORAGE-KEY==;EndpointSuffix=core.windows.net
# OR use these instead:
# AZURE_STORAGE_ACCOUNT_NAME=YOUR-STORAGE-ACCOUNT
# AZURE_STORAGE_SAS_TOKEN=?sv=2021-06-08&YOUR-SAS-TOKEN-HERE
BLOB_CONTAINER_NAME=lowtouch

# Databricks Configuration
DATABRICKS_SERVER_HOSTNAME=adb-YOUR-DATABRICKS-ID.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/YOUR-WAREHOUSE-ID
DATABRICKS_CATALOG=YOUR_CATALOG_NAME
DATABRICKS_SCHEMA=YOUR_SCHEMA_NAME
DATABRICKS_TABLE_SUFFIX=_dev

# Processing Configuration
PROCESSING_INTERVAL_MINUTES=5
MAX_RETRY_ATTEMPTS=3
BATCH_SIZE=10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Test Mode Configuration
TEST_MODE=false
TEST_EMAIL_OVERRIDE=test.user@contoso.com

# Health Monitoring
HEALTH_CHECK_PORT=8081
HEALTH_CHECK_ENABLED=true
METRICS_COLLECTION_INTERVAL=60
CONNECTION_POOL_HEALTH_CHECK_INTERVAL=30
OAUTH_HEALTH_CHECK_INTERVAL=120

# Connection Pool Configuration
CONNECTION_POOL_MIN_CONNECTIONS=2
CONNECTION_POOL_MAX_CONNECTIONS=5
CONNECTION_POOL_TIMEOUT_SECONDS=30
CONNECTION_POOL_HEALTH_CHECK_INTERVAL=300
CONNECTION_POOL_MAX_AGE_SECONDS=3600
CONNECTION_POOL_IDLE_TIMEOUT_SECONDS=1800
CONNECTION_POOL_WARMUP_TIMEOUT_SECONDS=60
CONNECTION_POOL_RETRY_ATTEMPTS=3
CONNECTION_POOL_RETRY_DELAY_SECONDS=1.0