# Azure Communication Services Configuration
ACS_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key
ACS_SENDER_EMAIL=noreply@your-domain.com
ACS_REPLY_TO_EMAIL=noreply@your-domain.com

# Azure Storage Configuration (Choose one authentication method)
# Option 1: Connection String (original method)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-key;EndpointSuffix=core.windows.net

# Option 2: SAS Token (recommended for enhanced security)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_SAS_TOKEN=?sv=2022-11-02&ss=b&srt=sco&sp=rwdlacupiytfx&se=2024-12-31T23:59:59Z&st=2024-01-01T00:00:00Z&spr=https&sig=your-sas-token-signature

BLOB_CONTAINER_NAME=lowtouch

# Databricks Configuration
DATABRICKS_SERVER_HOSTNAME=your-workspace.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_ACCESS_TOKEN=your-databricks-token
DATABRICKS_CATALOG=your_catalog
DATABRICKS_SCHEMA=your_schema
DATABRICKS_TABLE_SUFFIX=_dev

# Processing Configuration
PROCESSING_INTERVAL_MINUTES=5
MAX_RETRY_ATTEMPTS=3
BATCH_SIZE=10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application Configuration
ENVIRONMENT=development

# Test Mode Configuration
TEST_MODE=true
TEST_EMAIL_OVERRIDE=jgroenlund@microsoft.com