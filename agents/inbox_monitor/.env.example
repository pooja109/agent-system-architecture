# Inbox Monitor Service Configuration - EXAMPLE
# ==============================================
# This file contains example values for reference
# Copy to .env and replace with your actual values

# Service Identification
SERVICE_NAME=inbox-monitor
ENVIRONMENT=development

# Azure Key Vault Configuration
# WARNING: NEVER commit real credentials! These are example values only.
AZURE_KEY_VAULT_URL=https://YOUR-KEYVAULT-NAME-HERE.vault.azure.net/
AZURE_TENANT_ID=YOUR-TENANT-ID-HERE-1234-1234-123456789012
AZURE_CLIENT_ID=YOUR-CLIENT-ID-HERE-4321-4321-210987654321
AZURE_CLIENT_SECRET=YOUR-CLIENT-SECRET-HERE-NEVER-COMMIT-REAL-VALUES

# Key Vault Secret Names (Graph API)
KEY_VAULT_GRAPH_API_TENANT_ID_SECRET=graph-api-tenant-id
KEY_VAULT_GRAPH_API_CLIENT_ID_SECRET=graph-api-client-id
KEY_VAULT_GRAPH_API_CLIENT_SECRET_SECRET=graph-api-client-secret

# Key Vault Secret Names (Azure AI Foundry)
KEY_VAULT_AZURE_AI_FOUNDRY_ENDPOINT_SECRET=azure-ai-foundry-endpoint
KEY_VAULT_AZURE_AI_FOUNDRY_TENANT_ID_SECRET=azure-ai-foundry-tenant-id
KEY_VAULT_AZURE_AI_FOUNDRY_CLIENT_ID_SECRET=azure-ai-foundry-client-id
KEY_VAULT_AZURE_AI_FOUNDRY_CLIENT_SECRET_SECRET=azure-ai-foundry-client-secret

# Key Vault Secret Names (Salesforce)
KEY_VAULT_SALESFORCE_BASE_URL_SECRET=sf-base-url
KEY_VAULT_SALESFORCE_CLIENT_ID_SECRET=sf-client-id
KEY_VAULT_SALESFORCE_CLIENT_SECRET_SECRET=sf-client-secret
KEY_VAULT_SALESFORCE_TOKEN_ENDPOINT_SECRET=sf-token-endpoint
KEY_VAULT_SALESFORCE_API_VERSION_SECRET=sf-api-version
KEY_VAULT_SALESFORCE_CASE_RECORD_TYPE_ID_SECRET=sf-case-record-type-id
KEY_VAULT_SALESFORCE_CASE_QUEUE_SECRET=sf-case-queue

# Key Vault Secret Names (Service Principal)
KEY_VAULT_TENANT_ID_SECRET=sales-engagement-service-principal-tenantid
KEY_VAULT_CLIENT_ID_SECRET=sales-engagement-service-principal-clientid
KEY_VAULT_CLIENT_SECRET_SECRET=sales-engagement-service-principal-secretid

# Graph API Configuration
GRAPH_API_MONITORED_EMAIL=YOUR-MONITORED-EMAIL@YOUR-DOMAIN.com

# Databricks Configuration
DATABRICKS_SERVER_HOSTNAME=adb-YOUR-DATABRICKS-ID.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/YOUR-WAREHOUSE-ID
DATABRICKS_CATALOG=YOUR_CATALOG_NAME
DATABRICKS_SCHEMA=YOUR_SCHEMA_NAME
DATABRICKS_TABLE_SUFFIX=_dev

# Processing Configuration
INBOX_MONITOR_POLLING_INTERVAL=300
INBOX_MONITOR_BATCH_SIZE=10
INBOX_MONITOR_MAX_RETRY_ATTEMPTS=3
INBOX_MONITOR_RETRY_DELAY=30
INBOX_MONITOR_PROCESSED_FOLDER_PREFIX=Processed

# Output Configuration
INBOX_MONITOR_OUTPUT_TYPE=file
INBOX_MONITOR_OUTPUT_DIR=./output
INBOX_MONITOR_API_ENDPOINT=https://api.example.com/emails
INBOX_MONITOR_API_KEY=api-key-123456

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Test Mode Configuration
TEST_MODE=false
TEST_MODE_EMAIL=false
TEST_EMAIL_SENDER=tester@contoso.com
TEST_SALESFORCE_EMAIL=customer@salesforce.com
TEST_FORCE_SCENARIO=
FORCE_SCENARIO_9=false

# Content Formatting
CONTENT_FORMAT=structured
CONTENT_MAX_DESCRIPTION_LENGTH=30000
CONTENT_PRESERVE_SIGNATURE=true
CONTENT_INCLUDE_METADATA=true
CONTENT_TRUNCATE_HTML_FALLBACK=true

# Health Monitoring
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_ENABLED=true
METRICS_COLLECTION_INTERVAL=60
CONNECTION_POOL_HEALTH_CHECK_INTERVAL=30
OAUTH_HEALTH_CHECK_INTERVAL=120

# Prompt Management
PROMPTS_BASE_PATH=prompts
PROMPT_CACHE_TTL_SECONDS=300
PROMPT_ENABLE_HOT_RELOAD=false
PROMPT_SCHEMA_VALIDATION=true
PROMPT_MAX_CACHE_SIZE=100
PROMPT_PRELOAD_LIST=email_classification,email_forwarding
PROMPT_PERFORMANCE_MONITORING=true
PROMPT_FALLBACK_ENABLED=true

# Scenario Tracking
SCENARIO_TRACKING_ENABLED=true
SCENARIO_TRACKING_TABLE_SUFFIX=
SCENARIO_TRACKING_BATCH_SIZE=100
SCENARIO_TRACKING_ASYNC_INSERT=true
SCENARIO_TRACKING_RETRY_ATTEMPTS=3
SCENARIO_TRACKING_RETRY_DELAY=2.0
SCENARIO_TRACKING_CONNECTION_TIMEOUT=30
SCENARIO_TRACKING_PERFORMANCE_MONITORING=true
SCENARIO_TRACKING_SLOW_QUERY_THRESHOLD=5000
SCENARIO_TRACKING_HEALTH_CHECK_INTERVAL=300
SCENARIO_TRACKING_DATA_RETENTION_DAYS=365
SCENARIO_TRACKING_ARCHIVE_AFTER_DAYS=90
SCENARIO_TRACKING_CLEANUP_ENABLED=false

# Scenario Configuration
INBOX_MONITOR_TEST_EMAIL=john.doe@contoso.com
SCENARIO_VICTORIA_GRANT_EMAIL=victoria.grant@contoso.com
SCENARIO_ACCOUNT_TEAM_EMAIL=account-team@contoso.com

# Operational Flags
INBOX_MONITOR_DRY_RUN=false