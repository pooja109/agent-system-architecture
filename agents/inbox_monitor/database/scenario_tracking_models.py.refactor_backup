    def _extract_real_ai_model_version(cls, result: Any, kwargs: dict = None) -> str:
        """Extract real AI model version - ALWAYS returns a value, never None."""
        try:
            # FIRST: Check kwargs for scenario AI metadata from scenario processor
            if kwargs and 'scenario_ai_metadata' in kwargs:
                ai_metadata = kwargs['scenario_ai_metadata']
                if isinstance(ai_metadata, dict) and 'model_version' in ai_metadata:
