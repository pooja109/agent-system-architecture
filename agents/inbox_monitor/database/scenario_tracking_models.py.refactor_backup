    def calculate_performance_score(self) -> float:
        """
        Calculate a performance score based on processing metrics.
        Used for monitoring and optimization.
        """
        score = 100.0
        
        # Processing time penalty
        if self.processing_duration_ms:
            if self.processing_duration_ms > 30000:  # > 30 seconds
                score -= 50
            elif self.processing_duration_ms > 10000:  # > 10 seconds
                score -= 25
            elif self.processing_duration_ms > 5000:   # > 5 seconds
                score -= 10
        
        # AI confidence bonus/penalty
        if self.ai_confidence:
            if self.ai_confidence >= 0.9:
                score += 10
            elif self.ai_confidence < 0.6:
                score -= 20
        
        # Success bonus/penalty
        if self.process_success:
            score += 10
        else:
            score -= 30
        
        # Retry penalty
        score -= (self.retry_count * 10)
        
        return max(0.0, min(100.0, score))

    def get_customer_key(self) -> str:
        """Get standardized customer key for grouping and analytics."""
        return self.sender_email.lower().strip()

    def is_scenario_actionable(self) -> bool:
        """Determine if this scenario resulted in actionable outcomes."""
        actionable_indicators = [
            self.expert_assigned,
            self.case_created,
            self.emails_forwarded,
            self.external_operations_status,
            self.destination_folder
        ]
        return any(indicator for indicator in actionable_indicators)
        
