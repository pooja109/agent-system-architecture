    @field_validator("recipient_emails")
    def validate_recipient_emails(cls, v):
        """Validate email addresses in recipient list."""
        validated = []
        for email in v:
            if email and "@" in email and "." in email:
                validated.append(email.lower().strip())
            else:
                logger.warning("Invalid email in recipients list", email=email)
        return validated

    @model_validator(mode="after")
    def validate_scenario_consistency(self):
        """Ensure scenario-specific fields are consistent."""
        scenario_type = self.scenario_type
        
        # Validate expert assignment fields for Scenario 5
        if scenario_type == ScenarioType.SCENARIO_5:
            if self.expert_assigned and not self.expert_email:
                logger.warning("Expert assigned but no email provided")
        
        # Validate forwarding fields for forwarding scenarios
        forwarding_scenarios = {ScenarioType.SCENARIO_6, ScenarioType.SCENARIO_7, ScenarioType.SCENARIO_10}
        if scenario_type in forwarding_scenarios:
            if self.emails_forwarded and self.forwarding_success is None:
                self.forwarding_success = True  # Assume success if emails listed
                
        return self

    def to_databricks_dict(self) -> Dict[str, Any]:
        """
        Convert to dictionary format optimized for Databricks insertion.
        Handles type conversions and null value formatting.
        """
        # Use mode='json' to prevent serialization issues with complex types
        # Exclude processing_date since it's a generated column
        data = self.model_dump(exclude_none=False, mode='python', exclude={'processing_date'})
        
        # DEBUG: Log all boolean fields found
        boolean_fields_found = [k for k, v in data.items() if isinstance(v, bool)]
        logger.debug(f"Boolean fields found in model_dump: {boolean_fields_found}")
        
        # Convert datetime objects to ISO strings and handle type conversions
        for field_name, field_value in data.items():
            if isinstance(field_value, datetime):
                data[field_name] = field_value.isoformat()
            elif isinstance(field_value, bool):
                # Convert Python boolean to integer for Databricks compatibility
                data[field_name] = 1 if field_value else 0
                logger.debug(f"Converted boolean field {field_name}: {field_value} -> {data[field_name]}")
            elif field_name.endswith('_time_ms') and isinstance(field_value, float):
                # CRITICAL FIX: Convert float time values to integers for Databricks INT columns
                data[field_name] = int(round(field_value))
            elif field_name.endswith('_ms') and isinstance(field_value, float):
                # Convert all _ms fields from float to int
                data[field_name] = int(round(field_value))
        
        # CRITICAL FIX: Ensure ALL boolean fields are converted to integers
        # This handles any boolean fields that might be added after model creation
        boolean_fields = [
            'process_success', 'has_attachments', 'is_read', 'is_draft',
            'is_test_mode', 'contains_urls', 'contains_attachments', 'requires_human_review'
        ]
        
        for bool_field in boolean_fields:
            if bool_field in data:
                logger.debug(f"Checking field {bool_field}: value={data[bool_field]}, type={type(data[bool_field])}")
                if isinstance(data[bool_field], bool):
                    original_value = data[bool_field]
                    data[bool_field] = 1 if original_value else 0
                    logger.debug(f"FORCED boolean conversion {bool_field}: {original_value} -> {data[bool_field]}")
            else:
                logger.debug(f"Field {bool_field} not found in data")
        
        # Handle complex types for Databricks compatibility
        if self.status_updates:
            data["status_updates"] = [update.model_dump() for update in self.status_updates]
        
        # Note: Field filtering logic removed as extra fields have been cleaned up from the model
        
        # Ensure arrays are properly formatted as lists, not JSON strings
        for array_field in ["recipient_emails", "agent_actions_log", "ai_detected_phrases", 
                           "emails_forwarded", "customer_scenario_history"]:
            if array_field in data:
                original_value = data[array_field]
                original_type = type(original_value).__name__
                
                if data[array_field] is None:
                    data[array_field] = []
                elif isinstance(data[array_field], str):
                    # If it's a JSON string, parse it back to a list
                    try:
                        import json
                        data[array_field] = json.loads(data[array_field])
                        logger.debug(f"Converted {array_field} from JSON string to list", 
                                   original_type=original_type, 
                                   new_type=type(data[array_field]).__name__)
                    except (json.JSONDecodeError, TypeError):
                        # If parsing fails, treat as single item or empty list
                        data[array_field] = [data[array_field]] if data[array_field] else []
                        logger.debug(f"Converted {array_field} from string to single-item list", 
                                   original_type=original_type, 
                                   new_type=type(data[array_field]).__name__)
                elif not isinstance(data[array_field], list):
                    # Ensure it's a list
                    data[array_field] = [data[array_field]] if data[array_field] else []
                    logger.debug(f"Converted {array_field} to list", 
                               original_type=original_type, 
                               new_type=type(data[array_field]).__name__)
                else:
                    logger.debug(f"Field {array_field} is already a list", 
                               type=original_type, 
                               length=len(data[array_field]))
        
        # Ensure maps are properly formatted as dicts, not JSON strings
        for map_field in ["external_operations_status", "test_email_substitutions"]:
            if map_field in data:
                if data[map_field] is None:
                    data[map_field] = {}
                elif isinstance(data[map_field], str):
                    # If it's a JSON string, parse it back to a dict
                    try:
                        import json
                        data[map_field] = json.loads(data[map_field])
                    except (json.JSONDecodeError, TypeError):
                        data[map_field] = {}
                elif not isinstance(data[map_field], dict):
                    data[map_field] = {}
        
        # Remove advanced analytics metadata fields that don't exist in database
        # These fields were being added but the database schema doesn't include them
        
        # Field validation and conversion completed
        
        return data

    @classmethod
