    @classmethod
    def _get_real_storage_location(cls, scenario_result: Any, processing_result: Any) -> str:
        """Generate real storage_location based on scenario and processing results."""
        try:
            # Extract scenario type
            scenario_type = "unknown"
            if scenario_result and hasattr(scenario_result, 'scenario_type'):
                scenario_type = str(scenario_result.scenario_type).replace('ScenarioType.', '').lower()
            elif processing_result and hasattr(processing_result, 'scenario_type'):
                scenario_type = str(processing_result.scenario_type).replace('ScenarioType.', '').lower()
                
            # Extract processing ID for unique path
            process_id = "unknown"
            if processing_result and hasattr(processing_result, 'process_id'):
                process_id = processing_result.process_id[:8]  # First 8 chars
                
            now = datetime.now(timezone.utc)
            date_path = now.strftime('%Y/%m/%d')
            
            return f"inbox_monitor/scenarios/{scenario_type}/{date_path}/{process_id}/"
        except Exception as e:
