    @field_validator("recipient_emails")
    def validate_recipient_emails(cls, v):
        """Validate email addresses in recipient list."""
        validated = []
        for email in v:
            if email and "@" in email and "." in email:
                validated.append(email.lower().strip())
            else:
                logger.warning("Invalid email in recipients list", email=email)
        return validated

    @model_validator(mode="after")
    def validate_scenario_consistency(self):
        """Ensure scenario-specific fields are consistent."""
        scenario_type = self.scenario_type
        
        # Validate expert assignment fields for Scenario 5
        if scenario_type == ScenarioType.SCENARIO_5:
            if self.expert_assigned and not self.expert_email:
                logger.warning("Expert assigned but no email provided")
        
        # Validate forwarding fields for forwarding scenarios
        forwarding_scenarios = {ScenarioType.SCENARIO_6, ScenarioType.SCENARIO_7, ScenarioType.SCENARIO_10}
        if scenario_type in forwarding_scenarios:
            if self.emails_forwarded and self.forwarding_success is None:
                self.forwarding_success = True  # Assume success if emails listed
                
        return self

    def to_databricks_dict(self) -> Dict[str, Any]:
        """
        Convert to dictionary format optimized for Databricks insertion.
        Handles type conversions and null value formatting.
        """
        # Use mode='json' to prevent serialization issues with complex types
        # Exclude processing_date since it's a generated column
        data = self.model_dump(exclude_none=False, mode='python', exclude={'processing_date'})
        
        # DEBUG: Log all boolean fields found
        boolean_fields_found = [k for k, v in data.items() if isinstance(v, bool)]
        logger.debug(f"Boolean fields found in model_dump: {boolean_fields_found}")
        
        # Convert datetime objects to ISO strings and handle type conversions
        for field_name, field_value in data.items():
            if isinstance(field_value, datetime):
                data[field_name] = field_value.isoformat()
            elif isinstance(field_value, bool):
                # Convert Python boolean to integer for Databricks compatibility
                data[field_name] = 1 if field_value else 0
                logger.debug(f"Converted boolean field {field_name}: {field_value} -> {data[field_name]}")
            elif field_name.endswith('_time_ms') and isinstance(field_value, float):
                # CRITICAL FIX: Convert float time values to integers for Databricks INT columns
                data[field_name] = int(round(field_value))
            elif field_name.endswith('_ms') and isinstance(field_value, float):
                # Convert all _ms fields from float to int
                data[field_name] = int(round(field_value))
        
        # CRITICAL FIX: Ensure ALL boolean fields are converted to integers
        # This handles any boolean fields that might be added after model creation
        boolean_fields = [
            'process_success', 'has_attachments', 'is_read', 'is_draft',
            'is_test_mode', 'contains_urls', 'contains_attachments', 'requires_human_review'
        ]
        
        for bool_field in boolean_fields:
            if bool_field in data:
                logger.debug(f"Checking field {bool_field}: value={data[bool_field]}, type={type(data[bool_field])}")
                if isinstance(data[bool_field], bool):
                    original_value = data[bool_field]
                    data[bool_field] = 1 if original_value else 0
                    logger.debug(f"FORCED boolean conversion {bool_field}: {original_value} -> {data[bool_field]}")
            else:
                logger.debug(f"Field {bool_field} not found in data")
        
        # Handle complex types for Databricks compatibility
        if self.status_updates:
            data["status_updates"] = [update.model_dump() for update in self.status_updates]
        
        # Note: Field filtering logic removed as extra fields have been cleaned up from the model
        
        # Ensure arrays are properly formatted as lists, not JSON strings
        for array_field in ["recipient_emails", "agent_actions_log", "ai_detected_phrases", 
                           "emails_forwarded", "customer_scenario_history"]:
            if array_field in data:
                original_value = data[array_field]
                original_type = type(original_value).__name__
                
                if data[array_field] is None:
                    data[array_field] = []
                elif isinstance(data[array_field], str):
                    # If it's a JSON string, parse it back to a list
                    try:
                        import json
                        data[array_field] = json.loads(data[array_field])
                        logger.debug(f"Converted {array_field} from JSON string to list", 
                                   original_type=original_type, 
                                   new_type=type(data[array_field]).__name__)
                    except (json.JSONDecodeError, TypeError):
                        # If parsing fails, treat as single item or empty list
                        data[array_field] = [data[array_field]] if data[array_field] else []
                        logger.debug(f"Converted {array_field} from string to single-item list", 
                                   original_type=original_type, 
                                   new_type=type(data[array_field]).__name__)
                elif not isinstance(data[array_field], list):
                    # Ensure it's a list
                    data[array_field] = [data[array_field]] if data[array_field] else []
                    logger.debug(f"Converted {array_field} to list", 
                               original_type=original_type, 
                               new_type=type(data[array_field]).__name__)
                else:
                    logger.debug(f"Field {array_field} is already a list", 
                               type=original_type, 
                               length=len(data[array_field]))
        
        # Ensure maps are properly formatted as dicts, not JSON strings
        for map_field in ["external_operations_status", "test_email_substitutions"]:
            if map_field in data:
                if data[map_field] is None:
                    data[map_field] = {}
                elif isinstance(data[map_field], str):
                    # If it's a JSON string, parse it back to a dict
                    try:
                        import json
                        data[map_field] = json.loads(data[map_field])
                    except (json.JSONDecodeError, TypeError):
                        data[map_field] = {}
                elif not isinstance(data[map_field], dict):
                    data[map_field] = {}
        
        # Remove advanced analytics metadata fields that don't exist in database
        # These fields were being added but the database schema doesn't include them
        
        # Field validation and conversion completed
        
        return data

    @classmethod
    def from_processing_results(
        cls,
        email_data: Any,
        processing_result: Any,
        scenario_result: Any = None,
        intent_result: Any = None,
        **kwargs
    ) -> "ScenarioProcessingRecord":
        """
        Factory method to create record from existing processing results.
        Refactored to use specialized data extractors for maintainability and testability.
        
        Uses:
        - EmailDataExtractor: Extract and validate email-related data
        - ScenarioDataExtractor: Extract scenario processing results  
        - AIDataExtractor: Extract AI classification data
        - ScenarioProcessingRecordBuilder: Assemble final record
        """
        try:
            # Import the new extractors
            from .scenario_data_extractors import ScenarioProcessingRecordBuilder
            
            logger.debug("Creating scenario processing record using refactored extractors")
            
            # Use the builder to create the complete record data
            record_data = ScenarioProcessingRecordBuilder.build(
                processing_result=processing_result,
                email_data=email_data,
                scenario_result=scenario_result,
                intent_result=intent_result,
                **kwargs
            )
            
            # Create and validate the record
            try:
                return cls(**record_data)
            except ValidationError as ve:
                logger.warning(f"Validation error during record creation: {ve}")
                
                # Enhanced error recovery with field-by-field validation
                safe_record_data = {}
                problematic_fields = []
                successful_fields = []
                
                # Pre-filter Mock objects before validation
                filtered_record_data = {}
                for field_name, field_value in record_data.items():
                    if is_mock_object(field_value):
                        logger.debug(f"Filtering Mock object from field {field_name}")
                        problematic_fields.append(f"{field_name}=Mock")
                        continue
                    filtered_record_data[field_name] = field_value
                
                # Test each non-Mock field individually for validation
                for field_name, field_value in filtered_record_data.items():
                    try:
                        # Convert float time fields to integers before validation
                        if field_name.endswith('_time_ms') and isinstance(field_value, float):
                            field_value = int(field_value)
                        elif field_name.endswith('_processing_duration_ms') and isinstance(field_value, float):
                            field_value = int(field_value)
                        elif field_name in ['ai_processing_duration_ms', 'scenario_processing_duration_ms', 'processing_duration_ms'] and isinstance(field_value, float):
                            field_value = int(field_value)
                        
                        # Create minimal test record with just this field
                        test_record_data = get_minimal_record_data(record_data)
                        test_record_data[field_name] = field_value
                        
                        # Test Pydantic validation for this field
                        test_instance = cls(**test_record_data)
                        
                        # If validation succeeds, field is safe to include
                        safe_record_data[field_name] = field_value
                        successful_fields.append(field_name)
                        
                    except ValidationError as field_ve:
                        logger.debug(f"Field {field_name} failed validation: {field_ve}")
                        problematic_fields.append(f"{field_name}={type(field_value).__name__}")
                    except Exception as field_e:
                        logger.debug(f"Field {field_name} caused error: {field_e}")
                        problematic_fields.append(f"{field_name}=error")
                
                # Ensure minimum required fields are present with safe defaults
                safe_record_data.update(get_minimal_record_data(record_data))
                
                # Add validation recovery metadata for audit trail
                safe_record_data["process_error"] = f"Validation recovery: {len(successful_fields)} successful fields, {len(problematic_fields)} problematic fields"
                
                # Log detailed validation recovery information
                logger.info("Validation error recovery completed", 
                          total_fields=len(record_data),
                          successful_fields=len(successful_fields),
                          problematic_fields=len(problematic_fields),
                          successful_list=successful_fields[:10],
                          problematic_list=problematic_fields[:10])
                
                try:
                    return cls(**safe_record_data)
                except ValidationError as recovery_ve:
                    logger.error(f"Validation recovery failed: {recovery_ve}")
                    # Final fallback - return absolute minimum record
                    return cls(**get_minimal_record_data(record_data, include_error=True, error_msg=f"Recovery failed: {str(recovery_ve)}"))
            
        except Exception as e:
            logger.error("Failed to create scenario processing record", error=str(e))
            # Return minimal valid record on error
            return cls(
                process_id=str(uuid4()),
                email_id="error_" + str(uuid4()),
                sender_email="error@unknown.com",
                received_datetime=datetime.now(timezone.utc),
                process_success=False,
                process_error=f"Record creation failed: {str(e)}"
            )

    def calculate_performance_score(self) -> float:
        """
        Calculate a performance score based on processing metrics.
        Used for monitoring and optimization.
        """
        score = 100.0
        
        # Processing time penalty
        if self.processing_duration_ms:
            if self.processing_duration_ms > 30000:  # > 30 seconds
                score -= 50
            elif self.processing_duration_ms > 10000:  # > 10 seconds
                score -= 25
            elif self.processing_duration_ms > 5000:   # > 5 seconds
                score -= 10
        
        # AI confidence bonus/penalty
        if self.ai_confidence:
            if self.ai_confidence >= 0.9:
                score += 10
            elif self.ai_confidence < 0.6:
                score -= 20
        
        # Success bonus/penalty
        if self.process_success:
            score += 10
        else:
            score -= 30
        
        # Retry penalty
        score -= (self.retry_count * 10)
        
        return max(0.0, min(100.0, score))

    def get_customer_key(self) -> str:
        """Get standardized customer key for grouping and analytics."""
        return self.sender_email.lower().strip()

    def is_scenario_actionable(self) -> bool:
        """Determine if this scenario resulted in actionable outcomes."""
        actionable_indicators = [
            self.expert_assigned,
            self.case_created,
            self.emails_forwarded,
            self.external_operations_status,
            self.destination_folder
        ]
        return any(indicator for indicator in actionable_indicators)


