    @field_validator("sender_email")
    def validate_sender_email_security(cls, v):
        """Validate sender email for security issues."""
        if not v:
            return "unknown@unknown.com"
        
        # Basic security checks for malicious patterns
        malicious_patterns = [
            "'; DROP TABLE",
            "; --",
            "<script",
            "javascript:",
            "../../",
            "\\x00",
            "\n\r"
        ]
        
        for pattern in malicious_patterns:
            if pattern.lower() in v.lower():
                logger.warning("Malicious pattern detected in sender email", 
                               email=v[:50], pattern=pattern)
                return "[SANITIZED_EMAIL]"
        
        # Basic email format validation
        if "@" not in v or "." not in v:
            logger.debug("Invalid email format", email=v[:50])
            return "[INVALID_EMAIL]"
        
        # Length validation
        if len(v) > 254:
            logger.warning("Email exceeds RFC length limit", length=len(v))
            return "[OVERSIZED_EMAIL]"
        
        return v.lower().strip()

    @field_validator("subject")
    def validate_subject_security(cls, v):
        """Enhanced subject validation with security sanitization."""
        if not v:
            return v
        
        original_v = v
        
        # XSS protection - replace dangerous HTML/JS patterns
        import re
        xss_patterns = [
            r'<script[^>]*>.*?</script>',
            r'javascript:',
            r'vbscript:',
            r'onload\s*=',
            r'onerror\s*=',
            r';alert\s*\(',
            r'\.alert\s*\(',
            r'eval\s*\(',
            r'document\.write',
            r'document\.cookie',
        ]
        
        for pattern in xss_patterns:
            v = re.sub(pattern, '[SANITIZED]', v, flags=re.IGNORECASE)
        
        # SQL injection protection
        sql_patterns = [
            r"'; DROP TABLE",
            r"' OR '1'='1",
            r"' UNION SELECT",
        ]
        
        for pattern in sql_patterns:
            v = re.sub(pattern, '[SANITIZED]', v, flags=re.IGNORECASE)
        
        # Length validation
        if len(v) > 500:
            logger.warning("Subject line truncated", original_length=len(original_v))
            v = v[:497] + "..."
        
        # Log if sanitization occurred
        if v != original_v:
            logger.warning("Subject sanitization applied", 
                           original_length=len(original_v), 
                           sanitized_length=len(v))
        
        return v

    @field_validator("email_body")
    def validate_email_body_security(cls, v):
        """Enhanced body preview validation with security sanitization."""
        if not v:
            return v
        
        original_v = v
        
        # XSS protection - replace dangerous HTML/JS patterns  
        import re
        xss_patterns = [
            r'<script[^>]*>.*?</script>',
            r'javascript:',
            r'vbscript:',
            r'onload\s*=',
            r'onerror\s*=',
            r';alert\s*\(',
            r'\.alert\s*\(',
            r'eval\s*\(',
