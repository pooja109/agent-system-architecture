def is_mock_object(value: Any) -> bool:
    """
    Detect if a value is a Mock object to prevent test artifacts in production data.
    Enhanced detection covers various Mock patterns.
    """
    if value is None:
        return False
    
    try:
        value_str = str(value)
        value_type = type(value).__name__
        
        # Check for common Mock patterns
        mock_patterns = [
            '<Mock',           # Standard Mock objects
            '<MagicMock',      # MagicMock objects  
            '<AsyncMock',      # AsyncMock objects
            '<NonCallableMock' # NonCallableMock objects
        ]
        
        # Check string representation
        if any(pattern in value_str for pattern in mock_patterns):
            return True
            
        # Check type name
        mock_types = ['Mock', 'MagicMock', 'AsyncMock', 'NonCallableMock']
        if value_type in mock_types:
            return True
            
        # Check for mock module in type
        if hasattr(value, '__module__') and value.__module__ and 'mock' in value.__module__:
            return True
            
        return False
        
    except Exception:
        # If we can't determine, assume it's not a mock
        return False


def get_minimal_record_data(original_data: Dict[str, Any], include_error: bool = False, error_msg: str = None) -> Dict[str, Any]:
    """
    Get minimal required fields for a valid ScenarioProcessingRecord.
    Used for validation error recovery.
    """
    minimal_data = {
        "process_id": original_data.get("process_id", str(uuid4())),
        "email_id": original_data.get("email_id", "unknown"),
        "sender_email": original_data.get("sender_email", "unknown@unknown.com"),
        "received_datetime": original_data.get("received_datetime", datetime.now(timezone.utc)),
        "process_success": original_data.get("process_success", False),
    }
    
    if include_error:
        minimal_data["process_error"] = error_msg or "Record creation failed during validation recovery"
    
    return minimal_data


