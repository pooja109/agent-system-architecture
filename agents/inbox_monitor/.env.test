# Test Environment Variables for Container Testing
# ==============================================

# Azure Configuration (Test Values - DO NOT USE IN PRODUCTION)
AZURE_KEY_VAULT_URL=https://test-keyvault.vault.azure.net/
AZURE_TENANT_ID=test-tenant-id-12345
AZURE_CLIENT_ID=test-client-id-12345
AZURE_CLIENT_SECRET=test-client-secret-12345

# Email Configuration
GRAPH_API_MONITORED_EMAIL=test@example.com
INBOX_MONITOR_TEST_EMAIL=test@example.com

# Databricks Configuration (Test Values)
DATABRICKS_SERVER_HOSTNAME=test-databricks.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/test123456789abcdef
DATABRICKS_CATALOG=test_catalog
DATABRICKS_SCHEMA=test_schema

# Scenario Email Addresses
SCENARIO_VICTORIA_GRANT_EMAIL=victoria.grant@test.com
SCENARIO_ACCOUNT_TEAM_EMAIL=account.team@test.com

# Service Configuration
SERVICE_NAME=inbox-monitor
IS_CONTAINER=true
LOG_FORMAT=json
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Test Mode Settings
TEST_MODE=true
SKIP_AUTH_VALIDATION=true
USE_MOCK_SERVICES=true

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8080
METRICS_ENABLED=true

# Environment
ENVIRONMENT=test
DEBUG=false