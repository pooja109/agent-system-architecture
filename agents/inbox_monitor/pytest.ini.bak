[tool:pytest]
# Test discovery
testpaths = tests
python_files = test_*.py
python_classes = Test*
python_functions = test_*

# Test execution
addopts = 
    -v
    --tb=short
    --strict-markers
    --strict-config
    --disable-warnings
    --color=yes
    --durations=10
    --maxfail=5

# Coverage configuration
# Note: Run with: pytest --cov=. --cov-report=html --cov-report=term-missing
# Uncomment next line to enable coverage by default
# addopts += --cov=. --cov-report=term-missing --cov-fail-under=90

# Test markers
markers =
    unit: Unit tests for individual components
    integration: Integration tests for component interactions
    performance: Performance and load tests
    edge_case: Edge case and boundary condition tests
    error_condition: Error condition and failure scenario tests
    slow: Slow tests that may take more than 5 seconds
    network: Tests that require network access
    auth: Tests that require authentication
    file_system: Tests that interact with the file system
    concurrent: Tests that use concurrency or async operations
    retry: Tests that involve retry logic
    
# Test filtering
filterwarnings =
    ignore::DeprecationWarning
    ignore::PendingDeprecationWarning
    ignore::UserWarning:pydantic.*
    
# Asyncio configuration
asyncio_mode = auto

# Logging configuration
log_cli = false
log_cli_level = INFO
log_cli_format = %(asctime)s [%(levelname)8s] %(name)s: %(message)s
log_cli_date_format = %Y-%m-%d %H:%M:%S

# Timeout configuration
timeout = 300
timeout_method = thread

# Minimum version
minversion = 6.0

# Test collection
collect_ignore = [
    "setup.py",
    "conftest.py",
    "build",
    "dist",
    ".tox",
    ".eggs",
    "*.egg",
]

# Disable cacheprovider for consistent results
cache_dir = .pytest_cache