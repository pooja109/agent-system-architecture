# Development Dockerfile with debugging tools
FROM python:3.11-slim

# Install development dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    vim \
    git \
    procps \
    net-tools \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies with dev tools
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir \
    ipython \
    ipdb \
    pytest \
    pytest-asyncio \
    pytest-cov \
    black \
    flake8 \
    mypy

# Copy application code
COPY . .

# Ensure scripts are executable
RUN chmod +x docker-entrypoint.sh run.sh run.py

# Create necessary directories
RUN mkdir -p /app/logs /app/output

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SERVICE_NAME=inbox-monitor-dev \
    IS_CONTAINER=true \
    LOG_FORMAT=text \
    LOG_LEVEL=DEBUG

# Expose ports (health check + debugger)
EXPOSE 8080 5678

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Entry point for development
ENTRYPOINT ["./docker-entrypoint.sh"]

# Default to bash for development
CMD ["/bin/bash"]