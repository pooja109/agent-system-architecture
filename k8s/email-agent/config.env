# Email Agent Configuration Override
# These values override the default ConfigMap values for specific environments

# Processing Configuration Overrides
PROCESSING_INTERVAL_MINUTES=3
BATCH_SIZE=20
MAX_RETRY_ATTEMPTS=5

# Connection Pool Tuning
CONNECTION_POOL_MAX_CONNECTIONS=8
CONNECTION_POOL_TIMEOUT_SECONDS=45

# Environment Specific
LOG_LEVEL=INFO
TEST_MODE=false