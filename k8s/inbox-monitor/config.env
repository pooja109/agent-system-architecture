# Inbox Monitor Configuration Override
# These values override the default ConfigMap values for specific environments

# Processing Configuration Overrides
INBOX_MONITOR_POLLING_INTERVAL=180
INBOX_MONITOR_BATCH_SIZE=15

# Performance Tuning
PROMPT_CACHE_TTL_SECONDS=600
SCENARIO_TRACKING_BATCH_SIZE=200

# Environment Specific
LOG_LEVEL=INFO
PROMPT_ENABLE_HOT_RELOAD=false