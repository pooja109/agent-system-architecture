# =============================================================================
# Low-Touch V6 AOU-S01 Environment Configuration Sample
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit the actual .env file with real credentials

# =============================================================================
# Azure Communication Services Configuration
# =============================================================================
# ACS credentials are now retrieved from Azure Key Vault
# Required Key Vault secrets:
# - azure-communication-connection-string
# - azure-communication-sender-email
ACS_REPLY_TO_EMAIL=your-reply-to@yourcompany.com

# =============================================================================
# Azure Storage Configuration
# =============================================================================
# Choose one authentication method below

# Option 1: SAS Token (recommended for enhanced security)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_SAS_TOKEN=sv=2024-11-04&ss=bfqt&srt=sco&sp=rwdlacupyx&se=2025-12-31T23:59:59Z&st=2024-01-01T00:00:00Z&spr=https&sig=your-sas-token-signature

# Option 2: Connection String (alternative method)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-key;EndpointSuffix=core.windows.net

# Blob Service Configuration
BLOB_USE_ENTRA_ID=true
BLOB_CONTAINER_NAME=lowtouch

# =============================================================================
# Databricks Configuration
# =============================================================================
# For data operations and round-robin expert assignment
# OAuth authentication (preferred for enhanced security)
DATABRICKS_OAUTH_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_OAUTH_CLIENT_ID=your-databricks-oauth-client-id  
DATABRICKS_OAUTH_CLIENT_SECRET=your-databricks-oauth-client-secret
DATABRICKS_OAUTH_TENANT_ID=your-azure-tenant-id

# Legacy configuration (still supported but OAuth is preferred)
DATABRICKS_SERVER_HOSTNAME=https://your-workspace.azuredatabricks.net/
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_ACCESS_TOKEN=dapi-your-databricks-access-token

# Database configuration
DATABRICKS_CATALOG=your_catalog_name
DATABRICKS_SCHEMA=your_schema_name
DATABRICKS_TABLE_SUFFIX=_dev

# =============================================================================
# Processing Configuration
# =============================================================================
PROCESSING_INTERVAL_MINUTES=5
MAX_RETRY_ATTEMPTS=3
BATCH_SIZE=10

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# Test Mode Configuration
# =============================================================================
# Enable test mode to safely test without affecting production data
TEST_MODE=true
TEST_EMAIL_OVERRIDE=your-test-email@yourcompany.com
TEST_EMAIL_SENDER=your-email@yourcompany.com
TEST_SALESFORCE_EMAIL=real-customer@example.com
TEST_FORCE_SCENARIO=9

# =============================================================================
# Microsoft Graph API Configuration (for Email Monitoring)
# =============================================================================
# Graph API credentials are now retrieved from Azure Key Vault
# Required Key Vault secrets:
# - graph-api-tenant-id
# - graph-api-client-id
# - graph-api-client-secret
GRAPH_API_MONITORED_EMAIL=inbox@yourcompany.com

# =============================================================================
# Azure AI Foundry Configuration
# =============================================================================
# Azure AI Foundry credentials are now retrieved from Azure Key Vault
# Required Key Vault secrets:
# - azure-ai-foundry-endpoint
# - azure-ai-foundry-tenant-id
# - azure-ai-foundry-client-id
# - azure-ai-foundry-client-secret

# Semantic Kernel specific environment variables
AZURE_AI_AGENT_MODEL_DEPLOYMENT_NAME=gpt-4o

# =============================================================================
# Salesforce Configuration
# =============================================================================
# Salesforce credentials are now retrieved from Azure Key Vault
# Required Key Vault secrets:
# - sf-base-url
# - sf-client-id
# - sf-client-secret
# - sf-token-endpoint
# - sf-api-version
# - sf-case-record-type-id
# - sf-case-queue

# =============================================================================
# Inbox Monitor Scenario Configuration
# =============================================================================
# Email addresses for different scenarios (can be same for testing)
INBOX_MONITOR_TEST_EMAIL=test@yourcompany.com
SCENARIO_VICTORIA_GRANT_EMAIL=victoria.grant@yourcompany.com
SCENARIO_ACCOUNT_TEAM_EMAIL=accountteam@yourcompany.com

# Inbox Monitor Processing Configuration
INBOX_MONITOR_POLLING_INTERVAL=300
INBOX_MONITOR_BATCH_SIZE=10
INBOX_MONITOR_MAX_RETRY_ATTEMPTS=3
INBOX_MONITOR_RETRY_DELAY=30
INBOX_MONITOR_DRY_RUN=false

# =============================================================================
# Content Processing Configuration
# =============================================================================
# Email content formatting and case description generation
CONTENT_FORMAT=structured                  # Options: raw, clean_text, structured
CONTENT_MAX_DESCRIPTION_LENGTH=30000      # Maximum length for case descriptions
CONTENT_PRESERVE_SIGNATURE=true           # Preserve customer signature information
CONTENT_INCLUDE_METADATA=true             # Include metadata in formatted content
CONTENT_TRUNCATE_HTML_FALLBACK=true       # Fallback to truncated HTML if processing fails

# =============================================================================
# Prompt Management Configuration
# =============================================================================
# AI prompt system configuration for email classification
PROMPTS_BASE_PATH=prompts                  # Base path for prompt files
PROMPT_CACHE_TTL_SECONDS=300              # Prompt cache time-to-live
PROMPT_ENABLE_HOT_RELOAD=false            # Enable hot reload of prompts (dev only)
PROMPT_SCHEMA_VALIDATION=true             # Validate prompt schemas
PROMPT_MAX_CACHE_SIZE=100                 # Maximum number of cached prompts
PROMPT_PRELOAD_LIST=email_classification,email_forwarding  # Prompts to preload
PROMPT_PERFORMANCE_MONITORING=true       # Monitor prompt performance metrics
PROMPT_FALLBACK_ENABLED=true             # Enable fallback prompts on failure

# =============================================================================
# Health Monitoring Configuration
# =============================================================================
# HTTP health check endpoints for both email and inbox monitor agents
# Email agent uses port 8081, inbox monitor uses port 8080
HEALTH_CHECK_ENABLED=false              # Enable health endpoints (SECURITY: set to false)
HEALTH_CHECK_PORT_EMAIL=8081            # Health check server port for email agent
HEALTH_CHECK_PORT_INBOX=8080            # Health check server port for inbox monitor
METRICS_COLLECTION_INTERVAL=60          # Metrics collection interval (default: 60s)
CONNECTION_POOL_HEALTH_CHECK_INTERVAL=30 # Connection pool health check interval
OAUTH_HEALTH_CHECK_INTERVAL=120         # OAuth token health check interval

# =============================================================================
# Azure Key Vault OAuth Configuration
# =============================================================================
# Required for Key Vault access - used by both email and inbox monitor agents
AZURE_KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id  
AZURE_CLIENT_SECRET=your-azure-client-secret

# Key Vault Secret Names (these settings tell agents which secrets to look for)
KEY_VAULT_TENANT_ID_SECRET=sales-engagement-service-principal-tenantid
KEY_VAULT_CLIENT_ID_SECRET=sales-engagement-service-principal-clientid
KEY_VAULT_CLIENT_SECRET_SECRET=sales-engagement-service-principal-secretid
KEY_VAULT_ACS_CONNECTION_STRING_SECRET=azure-communication-connection-string
KEY_VAULT_ACS_SENDER_EMAIL_SECRET=azure-communication-sender-email

# =============================================================================
# AZURE KEY VAULT CONFIGURATION (Alternative to above)
# =============================================================================
# When using Azure Key Vault, you can reference secrets instead of hardcoding values
# This approach is recommended for production environments
#
# To use Key Vault, comment out the direct configuration above and use this pattern:
# Each secret in Key Vault should be named as shown below
#
# Prerequisites:
# 1. Create an Azure Key Vault resource
# 2. Add each secret to the Key Vault with the names shown below
# 3. Grant your application/service principal access to the Key Vault
# 4. Use Azure SDK or managed identity to access the secrets
#
# Key Vault Configuration:
# AZURE_KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/
#
# Secret Names in Key Vault (use these exact names):
#
# Azure Communication Services:
# - azure-communication-connection-string
# - azure-communication-sender-email
#
# Azure Storage:
# - azure-storage-account-name
# - azure-storage-sas-token
# - blob-container-name
#
# Databricks (OAuth preferred):
# - databricks-oauth-server-hostname
# - databricks-oauth-client-id
# - databricks-oauth-client-secret
# - databricks-oauth-tenant-id
# - databricks-catalog
# - databricks-schema
# - databricks-table-suffix
#
# Databricks (Legacy):
# - databricks-server-hostname
# - databricks-http-path
# - databricks-access-token
#
# Microsoft Graph API:
# - graph-api-tenant-id
# - graph-api-client-id
# - graph-api-client-secret
#
# Azure AI Foundry:
# - azure-ai-foundry-endpoint
# - azure-ai-foundry-tenant-id
# - azure-ai-foundry-client-id
# - azure-ai-foundry-client-secret
#
# Salesforce:
# - sf-base-url
# - sf-client-id
# - sf-client-secret
# - sf-token-endpoint
# - sf-api-version
# - sf-case-record-type-id
# - sf-case-queue
#
# Scenario Configuration:
# - inbox-monitor-test-email
# - scenario-victoria-grant-email
# - scenario-account-team-email
#
# Test Mode Configuration:
# - test-email-override
# - test-email-sender
# - test-salesforce-email
#
# Example code to use Key Vault (Python):
# 
# from azure.keyvault.secrets import SecretClient
# from azure.identity import DefaultAzureCredential
# 
# credential = DefaultAzureCredential()
# client = SecretClient(vault_url="https://your-keyvault-name.vault.azure.net/", credential=credential)
# 
# # Get secrets
# acs_connection_string = client.get_secret("acs-connection-string").value
# databricks_token = client.get_secret("databricks-access-token").value
# salesforce_client_secret = client.get_secret("salesforce-client-secret").value
#
# Benefits of using Key Vault:
# - Centralized secret management
# - Automatic secret rotation capabilities  
# - Enhanced security with managed identities
# - Audit logging of secret access
# - Integration with Azure RBAC
# - Compliance with enterprise security policies