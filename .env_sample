# =============================================================================
# Low-Touch V6 AOU-S01 Environment Configuration Sample
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit the actual .env file with real credentials

# =============================================================================
# Azure Communication Services Configuration
# =============================================================================
# For sending emails via Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key-here
ACS_SENDER_EMAIL=DoNotReply@your-domain.azurecomm.net
ACS_REPLY_TO_EMAIL=your-reply-to@yourcompany.com

# =============================================================================
# Azure Storage Configuration
# =============================================================================
# Choose one authentication method below

# Option 1: SAS Token (recommended for enhanced security)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_SAS_TOKEN=sv=2024-11-04&ss=bfqt&srt=sco&sp=rwdlacupyx&se=2025-12-31T23:59:59Z&st=2024-01-01T00:00:00Z&spr=https&sig=your-sas-token-signature

# Option 2: Connection String (alternative method)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-key;EndpointSuffix=core.windows.net

# Blob Service Configuration
BLOB_USE_ENTRA_ID=true
BLOB_CONTAINER_NAME=lowtouch

# =============================================================================
# Databricks Configuration
# =============================================================================
# For data operations and round-robin expert assignment
DATABRICKS_SERVER_HOSTNAME=https://your-workspace.azuredatabricks.net/
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_ACCESS_TOKEN=dapi-your-databricks-access-token
DATABRICKS_CATALOG=your_catalog_name
DATABRICKS_SCHEMA=your_schema_name
DATABRICKS_TABLE_SUFFIX=_dev

# =============================================================================
# Processing Configuration
# =============================================================================
PROCESSING_INTERVAL_MINUTES=5
MAX_RETRY_ATTEMPTS=3
BATCH_SIZE=10

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# Test Mode Configuration
# =============================================================================
# Enable test mode to safely test without affecting production data
TEST_MODE=true
TEST_EMAIL_OVERRIDE=your-test-email@yourcompany.com
TEST_EMAIL_SENDER=your-email@yourcompany.com
TEST_SALESFORCE_EMAIL=real-customer@example.com
TEST_FORCE_SCENARIO=9

# =============================================================================
# Microsoft Graph API Configuration (for Email Monitoring)
# =============================================================================
# For monitoring Microsoft 365 inbox
GRAPH_API_TENANT_ID=your-azure-ad-tenant-id
GRAPH_API_CLIENT_ID=your-app-registration-client-id
GRAPH_API_CLIENT_SECRET=your-app-registration-client-secret
GRAPH_API_MONITORED_EMAIL=inbox@yourcompany.com

# =============================================================================
# Azure AI Foundry Configuration
# =============================================================================
# For email intent classification using Semantic Kernel
AZURE_AI_ENDPOINT=https://your-ai-foundry-project.services.ai.azure.com/api/projects/YourProject
AZURE_AI_CONNECTION_STRING=https://your-ai-foundry-project.services.ai.azure.com/;your-key;your-resource-group;YourProject

# Semantic Kernel specific environment variables
AZURE_AI_AGENT_ENDPOINT=https://your-ai-foundry-project.services.ai.azure.com/api/projects/YourProject
AZURE_AI_AGENT_MODEL_DEPLOYMENT_NAME=gpt-4o

# =============================================================================
# Salesforce Configuration
# =============================================================================
# For creating cases and updating contact records
SALESFORCE_BASE_URL=https://your-org.sandbox.my.salesforce.com
SALESFORCE_CLIENT_ID=your-salesforce-connected-app-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-connected-app-client-secret
SALESFORCE_TOKEN_ENDPOINT=https://your-org.sandbox.my.salesforce.com/services/oauth2/token
SALESFORCE_API_VERSION=v64.0
SALESFORCE_CASE_RECORD_TYPE_ID=your-case-record-type-id
SALESFORCE_CASE_QUEUE=Expert Team

# =============================================================================
# Inbox Monitor Scenario Configuration
# =============================================================================
# Email addresses for different scenarios (can be same for testing)
INBOX_MONITOR_TEST_EMAIL=test@yourcompany.com
SCENARIO_VICTORIA_GRANT_EMAIL=victoria.grant@yourcompany.com
SCENARIO_ACCOUNT_TEAM_EMAIL=accountteam@yourcompany.com

# Inbox Monitor Processing Configuration
INBOX_MONITOR_POLLING_INTERVAL=300
INBOX_MONITOR_BATCH_SIZE=10
INBOX_MONITOR_MAX_RETRY_ATTEMPTS=3
INBOX_MONITOR_RETRY_DELAY=30
INBOX_MONITOR_DRY_RUN=false

# =============================================================================
# AZURE KEY VAULT CONFIGURATION (Alternative to above)
# =============================================================================
# When using Azure Key Vault, you can reference secrets instead of hardcoding values
# This approach is recommended for production environments
#
# To use Key Vault, comment out the direct configuration above and use this pattern:
# Each secret in Key Vault should be named as shown below
#
# Prerequisites:
# 1. Create an Azure Key Vault resource
# 2. Add each secret to the Key Vault with the names shown below
# 3. Grant your application/service principal access to the Key Vault
# 4. Use Azure SDK or managed identity to access the secrets
#
# Key Vault Configuration:
# AZURE_KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/
#
# Secret Names in Key Vault (use these exact names):
#
# Azure Communication Services:
# - acs-connection-string
# - acs-sender-email  
# - acs-reply-to-email
#
# Azure Storage:
# - azure-storage-account-name
# - azure-storage-sas-token
# - blob-container-name
#
# Databricks:
# - databricks-server-hostname
# - databricks-http-path
# - databricks-access-token
# - databricks-catalog
# - databricks-schema
# - databricks-table-suffix
#
# Microsoft Graph API:
# - graph-api-tenant-id
# - graph-api-client-id
# - graph-api-client-secret
# - graph-api-monitored-email
#
# Azure AI Foundry:
# - azure-ai-endpoint
# - azure-ai-connection-string
# - azure-ai-agent-endpoint
# - azure-ai-agent-model-deployment-name
#
# Salesforce:
# - salesforce-base-url
# - salesforce-client-id
# - salesforce-client-secret
# - salesforce-token-endpoint
# - salesforce-api-version
# - salesforce-case-record-type-id
# - salesforce-case-queue
#
# Scenario Configuration:
# - inbox-monitor-test-email
# - scenario-victoria-grant-email
# - scenario-account-team-email
#
# Test Mode Configuration:
# - test-email-override
# - test-email-sender
# - test-salesforce-email
#
# Example code to use Key Vault (Python):
# 
# from azure.keyvault.secrets import SecretClient
# from azure.identity import DefaultAzureCredential
# 
# credential = DefaultAzureCredential()
# client = SecretClient(vault_url="https://your-keyvault-name.vault.azure.net/", credential=credential)
# 
# # Get secrets
# acs_connection_string = client.get_secret("acs-connection-string").value
# databricks_token = client.get_secret("databricks-access-token").value
# salesforce_client_secret = client.get_secret("salesforce-client-secret").value
#
# Benefits of using Key Vault:
# - Centralized secret management
# - Automatic secret rotation capabilities  
# - Enhanced security with managed identities
# - Audit logging of secret access
# - Integration with Azure RBAC
# - Compliance with enterprise security policies